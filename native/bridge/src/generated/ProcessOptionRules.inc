    toggle_line("elefant_foot_compensation_layers", config->opt_float("elefant_foot_compensation") > 0 || config->option<ConfigOptionPercent>("elefant_foot_layers_density")->get_abs_value(1.0f) < 1.0f, -1, std::string("Enable elephant foot compensation or set elephant foot layer density below 100% to use this setting."));

    bool have_raft = config->opt_int("raft_layers") > 0 && !is_belt_printer;
    if (is_belt_printer)
        toggle_field("raft_layers", false, -1, std::string("Rafts are unavailable for belt printers."));
    bool have_support_material = config->opt_bool("enable_support") || have_raft;
    const std::string enable_support_reason = std::string("Enable support to edit this setting.");
    const std::string support_reason = is_belt_printer ? enable_support_reason :
                                                    std::string("Enable support or add raft layers to edit this setting.");

    SupportType support_type = config->opt_enum<SupportType>("support_type");
    bool have_support_interface = config->opt_int("support_interface_top_layers") > 0 || config->opt_int("support_interface_bottom_layers") > 0;
    bool have_support_soluble = have_support_material && config->opt_float("support_top_z_distance") == 0;
    auto support_style = config->opt_enum<SupportMaterialStyle>("support_style");
    for (auto el : { "support_style", "support_base_pattern",
        "support_base_pattern_spacing", "support_expansion", "support_angle",
        "support_interface_pattern", "support_interface_top_layers", "support_interface_bottom_layers",
        "bridge_no_support", "max_bridge_length", "support_top_z_distance", "support_bottom_z_distance",
        "support_type", "support_on_build_plate_only", "support_critical_regions_only", "support_interface_not_for_body",
        "support_object_xy_distance", "support_object_first_layer_gap", "independent_support_layer_height"})
        toggle_field(el, have_support_material, -1, support_reason);
    toggle_field("support_threshold_angle", have_support_material && is_auto(support_type), -1,
                 !have_support_material ? support_reason : std::string("Select an automatic support type to edit the threshold angle."));
    toggle_field("support_threshold_overlap", config->opt_int("support_threshold_angle") == 0 && have_support_material && is_auto(support_type), -1,
                 !have_support_material ? support_reason : std::string("Select an automatic support type and set the threshold angle to zero to edit threshold overlap."));
    //toggle_field("support_closing_radius", have_support_material && support_style == smsSnug);

    bool support_is_tree = config->opt_bool("enable_support") && is_tree(support_type);
    bool support_is_organic = support_is_tree && (support_style == smsTreeOrganic || support_style == smsDefault);
    bool support_is_normal_tree = support_is_tree && !support_is_organic;

    // hide settings that are not used by tree supports
    toggle_line("support_threshold_overlap", !support_is_tree, -1, std::string("Threshold overlap is unavailable for tree supports.")); // ORCA: tree supports do not use Threshold Overlap
    // settings specific to normal trees
    for (auto el : {"tree_support_branch_angle", "tree_support_branch_distance", "tree_support_branch_diameter", "tree_support_auto_brim", "tree_support_brim_width"})
        toggle_line(el, support_is_normal_tree, -1, std::string("Enable tree supports and select a style other than Organic or Default to show this setting."));
    // settings specific to organic trees
    for (auto el : {"tree_support_branch_angle_organic", "tree_support_branch_distance_organic", "tree_support_branch_diameter_organic", "tree_support_angle_slow", "tree_support_tip_diameter", "tree_support_top_rate", "tree_support_branch_diameter_angle"})
        toggle_line(el, support_is_organic, -1, std::string("Enable tree supports with the Organic or Default style to show this setting."));
    // ORCA: Independent support layer height is not compatible with organic tree supports,
    // as they rely on the support layers being the same as the object layers to determine where to place branches.
    toggle_line("independent_support_layer_height", have_support_material && !support_is_organic, -1,
                !have_support_material ? support_reason : std::string("Independent support layer height is unavailable for organic tree supports."));

    toggle_field("tree_support_brim_width", support_is_tree && !config->opt_bool("tree_support_auto_brim"), -1,
                 std::string("Enable tree supports and turn off automatic brim width to edit the tree support brim width."));
    // tree support use max_bridge_length instead of bridge_no_support
    toggle_line("max_bridge_length", support_is_tree, -1, std::string("Enable tree supports to show the maximum bridge length."));
    toggle_line("bridge_no_support", !support_is_tree, -1, std::string("Tree supports use maximum bridge length instead of the bridge support setting."));
    toggle_line("support_critical_regions_only", is_auto(support_type) && support_is_tree, -1, std::string("Enable automatic tree supports to show this setting."));

    for (auto el : { "support_interface_filament",
        "support_interface_loop_pattern", "support_bottom_interface_spacing" })
        toggle_field(el, have_support_material && have_support_interface, -1,
                     !have_support_material ? support_reason : std::string("Set top or bottom support interface layers above zero to edit this setting."));

    bool can_ironing_support = have_raft || (have_support_material && config->opt_int("support_interface_top_layers") > 0);
    toggle_field("support_ironing", can_ironing_support, -1, std::string("Enable a raft, or enable supports with top interface layers, to use support ironing."));
    bool has_support_ironing = can_ironing_support && config->opt_bool("support_ironing");
    for (auto el : {"support_ironing_pattern", "support_ironing_flow", "support_ironing_spacing" })
        toggle_line(el, has_support_ironing, -1, std::string("Enable support ironing with a raft or top support interface layers to show this setting."));
    // Orca: Force solid support interface when using support ironing
    toggle_field("support_interface_spacing", have_support_material && have_support_interface && !has_support_ironing, -1,
                 !have_support_material ? support_reason :
                 !have_support_interface ? std::string("Set top or bottom support interface layers above zero to edit interface spacing.") :
                                          std::string("Support ironing requires a solid interface, so interface spacing cannot be edited."));

//    see issue #10915
//    bool have_skirt_height = have_skirt &&
//    (config->opt_int("skirt_height") > 1 || config->opt_enum<DraftShield>("draft_shield") != dsEnabled);
//    toggle_line("support_speed", have_support_material || have_skirt_height);
//    toggle_line("support_interface_speed", have_support_material && have_support_interface);

    // Orca:
    for (auto el : {"small_support_perimeter_speed", "small_support_perimeter_threshold"})
        toggle_field(el, config->opt_bool("enable_support"), -1, enable_support_reason);

    // BBS
    //toggle_field("support_material_synchronize_layers", have_support_soluble);

    toggle_field("inner_wall_line_width", have_perimeters || have_skirt || have_brim, -1, std::string("Enable walls, a skirt or a brim to edit inner wall line width."));
    toggle_field("support_filament", have_support_material || have_skirt, -1, std::string("Enable support, a raft, or a skirt to select the support filament."));

    toggle_line("raft_contact_distance", have_raft && !have_support_soluble, -1,
                !have_raft ? std::string("Add raft layers to show raft contact distance.") : std::string("Raft contact distance is unavailable when the top support Z distance is zero."));
    // Orca:Hide raft expansion when raft is not enabled
    toggle_line("raft_expansion", have_raft, -1, std::string("Add raft layers to show raft expansion."));
    // Orca: Slim, Strong and Hybrid tree supports size their raft by first layer expansion only.
    toggle_field("raft_expansion", !(is_tree(support_type) && (support_style == smsTreeSlim || support_style == smsTreeStrong || support_style == smsTreeHybrid)), -1,
                 std::string("Slim, Strong and Hybrid tree supports use first layer expansion instead of raft expansion."));

    // Orca: First-layer density is available for supports broadly.
    toggle_field("raft_first_layer_density", have_support_material, -1, support_reason);
    // Orca: For regular tree (Slim/Strong) without raft, hide first-layer expansion.
    // Keep it enabled for non-tree supports, organic tree, hybrid tree, and any raft case.
    toggle_field("raft_first_layer_expansion",
                 have_support_material && ((!support_is_normal_tree || support_style == smsTreeHybrid) || have_raft), -1,
                 !have_support_material ? support_reason : std::string("Add a raft or choose a tree support style other than Slim or Strong to edit first layer expansion."));

    bool has_ironing = (config->opt_enum<IroningType>("ironing_type") != IroningType::NoIroning);
    for (auto el : { "ironing_pattern", "ironing_flow", "ironing_spacing", "ironing_angle", "ironing_inset", "ironing_angle_fixed" })
        toggle_line(el, has_ironing, -1, std::string("Enable ironing to use this setting."));
    bool has_rectilinear_ironing = (config->opt_enum<InfillPattern>("ironing_pattern") == InfillPattern::ipRectilinear);
    for (auto el : {"ironing_angle", "ironing_angle_fixed"})
        toggle_field(el, has_ironing && has_rectilinear_ironing, -1, std::string("Enable ironing with the Rectilinear pattern to edit ironing angles."));
    
    toggle_line("ironing_speed", has_ironing || has_support_ironing, -1, std::string("Enable ironing or support ironing to edit ironing speed."));

    bool has_zaa = config->opt_bool("zaa_enabled");
    for (auto el : {"zaa_minimize_perimeter_height", "zaa_min_z", "zaa_dont_alternate_fill_direction", "ironing_expansion"})
        toggle_line(el, has_zaa, -1, std::string("Enable Z contouring to use this setting."));

    bool have_sequential_printing = (config->opt_enum<PrintSequence>("print_sequence") == PrintSequence::ByObject);
    // for (auto el : { "extruder_clearance_radius", "extruder_clearance_height_to_rod", "extruder_clearance_height_to_lid" })
    //     toggle_field(el, have_sequential_printing);
    toggle_field("print_order", !have_sequential_printing, -1, std::string("Print order cannot be edited when the print sequence is By object."));

    toggle_field("single_extruder_multi_material", !is_BBL_Printer, -1, std::string("This setting is unavailable for Bambu Lab printers."));

    auto bSEMM = printer_config.opt_bool("single_extruder_multi_material");
    const bool supports_wipe_tower_2 = !is_BBL_Printer && printer_config.opt_enum<WipeTowerType>("wipe_tower_type") == WipeTowerType::Type2;

    toggle_field("ooze_prevention", !bSEMM, -1, std::string("This setting is unavailable in single extruder multimaterial mode."));
    bool have_ooze_prevention = config->opt_bool("ooze_prevention");
    const std::string ooze_prevention_reason = std::string("Enable ooze prevention to use this setting.");
    toggle_line("standby_temperature_delta", have_ooze_prevention, -1, ooze_prevention_reason);
    toggle_line("preheat_time", have_ooze_prevention, -1, ooze_prevention_reason);
    int preheat_steps = config->opt_int("preheat_steps");
    toggle_line("preheat_steps", have_ooze_prevention && (preheat_steps > 0), -1, std::string("Enable ooze prevention and use a positive number of preheat steps to show this setting."));

    bool have_prime_tower = config->opt_bool("enable_prime_tower");
    // ORCA-Belt: belt printers replace the classic wipe tower with the
    // auto-generated belt purge prism, enabled by the belt-only printer option
    // enable_belt_purge_tower. Its width (a process option) is only relevant
    // then. (is_belt_printer is computed at the top of this function.)
    const bool have_belt_purge_tower = is_belt_printer
        && printer_config.has("enable_belt_purge_tower")
        && printer_config.opt_bool("enable_belt_purge_tower");
    toggle_line("belt_purge_tower_width", have_belt_purge_tower, -1, std::string("Enable the belt purge tower in the belt printer settings to use this setting."));
    const std::string prime_tower_reason = std::string("Enable the prime tower on a non-belt printer to use this setting.");
    for (auto el : {"prime_tower_width", "prime_tower_brim_width", "prime_tower_skip_points", "wipe_tower_wall_type", "prime_tower_infill_gap","prime_tower_enable_framework", "enable_tower_interface_features"})
        toggle_line(el, have_prime_tower && !is_belt_printer, -1, prime_tower_reason);

    toggle_line("enable_tower_interface_cooldown_during_tower",
                have_prime_tower && !is_belt_printer && config->opt_bool("enable_tower_interface_features"), -1, std::string("Enable the prime tower and tower interface features on a non-belt printer to use this setting."));

    bool purge_in_primetower = printer_config.opt_bool("purge_in_prime_tower");

    for (auto el : {"wipe_tower_rotation_angle", "wipe_tower_cone_angle",
                    "wipe_tower_extra_spacing", "wipe_tower_max_purge_speed",
                    "wipe_tower_bridging", "wipe_tower_extra_flow"})
            toggle_line(el, have_prime_tower && supports_wipe_tower_2 && !is_belt_printer, -1, std::string("Enable the prime tower and select wipe tower Type 2 on a non-Bambu, non-belt printer."));

    // Orca: both tower generators skip sparse layers, so this is not a wipe tower 2 exclusive.
    toggle_line("wipe_tower_no_sparse_layers", have_prime_tower && !is_belt_printer, -1, prime_tower_reason);
    // Dropping the sparse layers outright leaves nothing to combine, so the two are exclusive.
    toggle_line("wipe_tower_sparse_layers_combination", have_prime_tower && !is_belt_printer && !config->opt_bool("wipe_tower_no_sparse_layers"), -1, std::string("Enable the prime tower on a non-belt printer and turn off skipping sparse tower layers to use layer combination."));

    WipeTowerWallType wipe_tower_wall_type = config->opt_enum<WipeTowerWallType>("wipe_tower_wall_type");
    bool have_rib_wall = (wipe_tower_wall_type == WipeTowerWallType::wtwRib)&&have_prime_tower&&!is_belt_printer;
    const std::string rib_wall_reason = std::string("Enable the prime tower with Rib walls on a non-belt printer to use this setting.");
    toggle_line("wipe_tower_cone_angle", have_prime_tower && supports_wipe_tower_2 && !is_belt_printer && wipe_tower_wall_type == WipeTowerWallType::wtwCone, -1, std::string("Enable a Type 2 prime tower with Cone walls on a non-Bambu, non-belt printer."));
    toggle_line("wipe_tower_extra_rib_length", have_rib_wall, -1, rib_wall_reason);
    toggle_line("wipe_tower_rib_width", have_rib_wall, -1, rib_wall_reason);
    toggle_line("wipe_tower_fillet_wall", have_rib_wall, -1, rib_wall_reason);
    toggle_field("prime_tower_width", have_prime_tower && !have_rib_wall && !is_belt_printer, -1, std::string("Enable the prime tower on a non-belt printer and choose a wall type other than Rib to edit tower width."));

    toggle_line("single_extruder_multi_material_priming", !bSEMM && have_prime_tower && supports_wipe_tower_2 && !is_belt_printer, -1, std::string("Enable a Type 2 prime tower on a non-Bambu, non-belt printer and disable single extruder multimaterial mode."));

    bool use_cyclic_ordering = config->opt_enum<ToolChangeOrderingType>("toolchange_ordering") == ToolChangeOrderingType::Cyclic;
    const std::string cyclic_order_reason = std::string("Select Cyclic tool change ordering to use this setting.");
    toggle_line("toolchange_cyclic_order", use_cyclic_ordering, -1, cyclic_order_reason);
    toggle_line("toolchange_cyclic_first_layer", use_cyclic_ordering, -1, cyclic_order_reason);

    toggle_line("prime_volume",have_prime_tower && (!purge_in_primetower || !bSEMM), -1, std::string("Enable the prime tower and either disable purging in the prime tower or disable single extruder multimaterial mode."));
    // Orca: the Type 1 tower takes the prime volume of each filament instead.
    toggle_field("prime_volume", supports_wipe_tower_2, -1, std::string("The Type 1 prime tower takes the prime volume from each filament, on its Multimaterial page."));

    for (auto el : {"flush_into_infill", "flush_into_support", "flush_into_objects"})
        toggle_field(el, have_prime_tower, -1, std::string("Enable the prime tower to use this setting."));

    bool have_avoid_crossing_perimeters = config->opt_bool("reduce_crossing_wall");
    toggle_line("max_travel_detour_distance", have_avoid_crossing_perimeters, -1, std::string("Enable avoiding crossing walls to edit the maximum travel detour distance."));

    bool has_set_other_flow_ratios = config->opt_bool("set_other_flow_ratios");
    for (auto el : {"first_layer_flow_ratio", "outer_wall_flow_ratio", "inner_wall_flow_ratio", "overhang_flow_ratio", "sparse_infill_flow_ratio", "internal_solid_infill_flow_ratio", "gap_fill_flow_ratio", "support_flow_ratio", "support_interface_flow_ratio"})
        toggle_line(el, has_set_other_flow_ratios, -1, std::string("Enable setting other flow ratios to use this setting."));

    bool has_overhang_speed = config->opt_bool_nullable("enable_overhang_speed", variant_index);
    const std::string overhang_speed_reason = std::string("Enable slowing down for overhangs to use this setting.");
    for (auto el : {"overhang_1_4_speed", "overhang_2_4_speed", "overhang_3_4_speed", "overhang_4_4_speed"})
        toggle_line(el, has_overhang_speed, variant_index, overhang_speed_reason);

    toggle_line("slowdown_for_curled_perimeters", has_overhang_speed, variant_index, overhang_speed_reason);

    toggle_line("flush_into_objects", !is_global_config, -1, std::string("This setting is available in object settings rather than global print settings."));

    toggle_line("support_interface_not_for_body",config->opt_int("support_interface_filament")&&!config->opt_int("support_filament"), -1,
                std::string("Select a specific support interface filament and use the default support filament to show this setting."));

    // Get the current fuzzy skin state
    bool has_fuzzy_skin = config->opt_enum<FuzzySkinType>("fuzzy_skin") != FuzzySkinType::Disabled_fuzzy;
    
    // Show fuzzy skin options when fuzzy skin is not disabled
    for (auto el : {"fuzzy_skin_mode", "fuzzy_skin_noise_type", "fuzzy_skin_point_distance", "fuzzy_skin_thickness", "fuzzy_skin_first_layer"})
        toggle_line(el, has_fuzzy_skin, -1, std::string("Enable fuzzy skin to use this setting."));
    
    // Show noise type specific options with the same logic
    NoiseType fuzzy_skin_noise_type = config->opt_enum<NoiseType>("fuzzy_skin_noise_type");
    const bool is_ripple = fuzzy_skin_noise_type == NoiseType::Ripple;
    const std::string ripple_noise_reason = std::string("Enable fuzzy skin with Ripple noise to use this setting.");
    toggle_line("fuzzy_skin_scale", fuzzy_skin_noise_type != NoiseType::Classic && has_fuzzy_skin && !is_ripple, -1, std::string("Enable fuzzy skin and select a noise type other than Classic or Ripple to edit noise scale."));
    toggle_line("fuzzy_skin_octaves", fuzzy_skin_noise_type != NoiseType::Classic && fuzzy_skin_noise_type != NoiseType::Voronoi && has_fuzzy_skin && !is_ripple, -1, std::string("Enable fuzzy skin and select a noise type other than Classic, Voronoi or Ripple to edit noise octaves."));
    toggle_line("fuzzy_skin_persistence", (fuzzy_skin_noise_type == NoiseType::Perlin || fuzzy_skin_noise_type == NoiseType::Billow) && has_fuzzy_skin && !is_ripple, -1, std::string("Enable fuzzy skin with Perlin or Billow noise to edit persistence."));
    toggle_line("fuzzy_skin_ripples_per_layer", is_ripple && has_fuzzy_skin, -1, ripple_noise_reason);
    toggle_line("fuzzy_skin_ripple_offset", is_ripple && has_fuzzy_skin, -1, ripple_noise_reason);
    toggle_line("fuzzy_skin_layers_between_ripple_offset", is_ripple && has_fuzzy_skin, -1, ripple_noise_reason);

    bool have_arachne = config->opt_enum<PerimeterGeneratorType>("wall_generator") == PerimeterGeneratorType::Arachne;
    for (auto el : {"wall_transition_length", "wall_transition_filter_deviation", "wall_transition_angle", "min_feature_size", "min_length_factor",
        "min_bead_width", "wall_distribution_count", "initial_layer_min_bead_width", "wall_maximum_resolution", "wall_maximum_deviation"})
        toggle_line(el, have_arachne, -1, std::string("Select the Arachne wall generator to use this setting."));
    toggle_field("detect_thin_wall", !have_arachne, -1, std::string("Thin wall detection is unavailable with the Arachne wall generator."));

    // Orca
    auto is_role_based_wipe_speed = config->opt_bool("role_based_wipe_speed");
    toggle_field("wipe_speed",!is_role_based_wipe_speed, -1, std::string("Disable role-based wipe speed to edit wipe speed manually."));

    const bool have_wipe_inward = config->opt_bool("wipe_inward");
    toggle_line("wipe_inward_distance", have_wipe_inward, -1, std::string("Enable inward wiping to edit inward wipe distance."));

    for (auto el : {"accel_to_decel_enable", "accel_to_decel_factor"})
        toggle_line(el, gcf_is_klipper, -1, std::string("This setting requires the Klipper G-code flavor."));
    if(gcf_is_klipper)
        toggle_field("accel_to_decel_factor", config->opt_bool("accel_to_decel_enable"), -1, std::string("Enable acceleration to deceleration to edit its factor."));

    toggle_line("exclude_object_tolerance", gcf_is_klipper && config->opt_bool("exclude_object"), -1,
                std::string("Enable excluding objects with the Klipper G-code flavor to edit the outline tolerance."));

    bool have_make_overhang_printable = config->opt_bool("make_overhang_printable");
    const std::string printable_overhang_reason = std::string("Enable making overhangs printable to use this setting.");
    toggle_line("make_overhang_printable_angle", have_make_overhang_printable, -1, printable_overhang_reason);
    toggle_line("make_overhang_printable_hole_size", have_make_overhang_printable, -1, printable_overhang_reason);

    // Orca: the one-wall options act on top/bottom surfaces, which exist only with a shell. An unfilled surface
    // (0% surface density) is still a surface, so these are gated on the layer counts alone.
    toggle_line("only_one_wall_first_layer", has_bottom_shell, -1, bottom_shell_reason);
    toggle_line("only_one_wall_top", has_top_shell_layers, -1, top_shell_layers_reason);
    toggle_line("min_width_top_surface", (has_top_shell_layers && config->opt_bool("only_one_wall_top")) || ((config->opt_float("min_length_factor") > 0.5f) && have_arachne), -1, std::string("Enable only one wall on top surfaces with top shell layers, or use Arachne with a minimum wall length factor above 0.5.")); // 0.5 is default value

    for (auto el : { "hole_to_polyhole_threshold", "hole_to_polyhole_twisted", "hole_to_polyhole_max_edges" })
        toggle_line(el, config->opt_bool("hole_to_polyhole"), -1, std::string("Enable converting holes to polyholes to use this setting."));

    bool has_detect_overhang_wall = config->opt_bool("detect_overhang_wall");
    bool has_overhang_reverse     = config->opt_bool("overhang_reverse");
    bool allow_overhang_reverse   = !has_spiral_vase;
    toggle_line("unsupported_wall_last", has_detect_overhang_wall, -1, std::string("Enable overhang wall detection to use this setting."));
    toggle_line("overhang_reverse", allow_overhang_reverse, -1, std::string("Reverse overhang direction is unavailable in spiral vase mode."));
    toggle_line("overhang_reverse_internal_only", allow_overhang_reverse && has_overhang_reverse, -1, std::string("Disable spiral vase mode and enable reverse overhang direction to use this setting."));
    bool has_overhang_reverse_internal_only = config->opt_bool("overhang_reverse_internal_only");
    if (has_overhang_reverse_internal_only){
        DynamicPrintConfig new_conf = *config;
        new_conf.set_key_value("overhang_reverse_threshold", new ConfigOptionFloatOrPercent(0,true));
        apply(config, &new_conf);
    }
    toggle_line("overhang_reverse_threshold", has_detect_overhang_wall && allow_overhang_reverse && has_overhang_reverse && !has_overhang_reverse_internal_only, -1, std::string("Enable overhang wall detection and reverse overhang direction, disable spiral vase mode, and turn off reversing internal perimeters only."));
    toggle_line("timelapse_type", is_BBL_Printer, -1, std::string("This setting requires a Bambu Lab printer."));


    bool have_small_area_infill_flow_compensation = config->opt_bool("small_area_infill_flow_compensation");
    toggle_line("small_area_infill_flow_compensation_model", have_small_area_infill_flow_compensation, -1, std::string("Enable small area infill flow compensation to edit its model."));


    // Belt printers: the scarf would start one layer back along the belt, inside the
    // previous layer (GCode::extrude_loop skips it there too).
    toggle_field("seam_slope_type", !has_spiral_vase && !is_belt_printer, -1, std::string("Scarf seams are unavailable in spiral vase mode and for belt printers."));
    bool has_seam_slope = !has_spiral_vase && !is_belt_printer && config->opt_enum<SeamScarfType>("seam_slope_type") != SeamScarfType::None;
    const std::string scarf_seam_reason = std::string("Enable scarf seams on a non-belt printer with spiral vase mode disabled to use this setting.");
    toggle_line("seam_slope_conditional", has_seam_slope, -1, scarf_seam_reason);
    toggle_line("seam_slope_start_height", has_seam_slope, -1, scarf_seam_reason);
    toggle_line("seam_slope_entire_loop", has_seam_slope, -1, scarf_seam_reason);
    toggle_line("seam_slope_min_length", has_seam_slope, -1, scarf_seam_reason);
    toggle_line("seam_slope_steps", has_seam_slope, -1, scarf_seam_reason);
    toggle_line("seam_slope_inner_walls", has_seam_slope, -1, scarf_seam_reason);
    toggle_line("scarf_joint_speed", has_seam_slope, -1, scarf_seam_reason);
    toggle_line("scarf_joint_flow_ratio", has_seam_slope, -1, scarf_seam_reason);
    toggle_field("seam_slope_min_length", !config->opt_bool("seam_slope_entire_loop"), -1, std::string("Disable scarfing the entire loop to edit the minimum scarf length."));
    const std::string conditional_scarf_reason = std::string("Enable conditional scarf seams on a non-belt printer with spiral vase mode disabled to use this setting.");
    toggle_line("scarf_angle_threshold", has_seam_slope && config->opt_bool("seam_slope_conditional"), -1, conditional_scarf_reason);
    toggle_line("scarf_overhang_threshold", has_seam_slope && config->opt_bool("seam_slope_conditional"), -1, conditional_scarf_reason);

    bool use_beam_interlocking = config->opt_bool("interlocking_beam");
    const std::string beam_interlocking_reason = std::string("Enable beam interlocking to use this setting.");
    toggle_line("mmu_segmented_region_interlocking_depth", !use_beam_interlocking, -1, std::string("Disable beam interlocking to edit segmented region interlocking depth."));
    toggle_line("interlocking_beam_width", use_beam_interlocking, -1, beam_interlocking_reason);
    toggle_line("interlocking_orientation", use_beam_interlocking, -1, beam_interlocking_reason);
    toggle_line("interlocking_beam_layer_count", use_beam_interlocking, -1, beam_interlocking_reason);
    toggle_line("interlocking_depth", use_beam_interlocking, -1, beam_interlocking_reason);
    toggle_line("interlocking_boundary_avoidance", use_beam_interlocking, -1, beam_interlocking_reason);

    bool lattice_options = config->opt_enum<InfillPattern>("sparse_infill_pattern") == InfillPattern::ipLateralLattice;
    for (auto el : { "lateral_lattice_angle_1", "lateral_lattice_angle_2"})
        toggle_line(el, lattice_options, -1, std::string("Select the Lateral Lattice sparse infill pattern to use this setting."));

    bool lightning_options = config->opt_enum<InfillPattern>("sparse_infill_pattern") == InfillPattern::ipLightning && have_infill;
    for (auto el : { "lightning_overhang_angle", "lightning_prune_angle", "lightning_straightening_angle" })
        toggle_line(el, lightning_options, -1, std::string("Select the Lightning sparse infill pattern to use this setting."));
        
    // Adaptative Cubic and support cubic infill patterns do not support infill rotation.
    bool FillAdaptive = (pattern == InfillPattern::ipAdaptiveCubic || pattern == InfillPattern::ipSupportCubic);

    //Orca: disable infill_direction/solid_infill_direction if sparse_infill_rotate_template/solid_infill_rotate_template is not empty value and adaptive cubic/support cubic infill pattern is not selected
    toggle_field("sparse_infill_rotate_template", !FillAdaptive, -1, std::string("Infill rotation templates are unavailable for Adaptive Cubic and Support Cubic infill."));
    toggle_field("infill_direction", config->opt_string("sparse_infill_rotate_template") == "" && !FillAdaptive, -1, std::string("Clear the sparse infill rotation template and choose a pattern other than Adaptive Cubic or Support Cubic to edit infill direction."));
    toggle_field("solid_infill_direction", config->opt_string("solid_infill_rotate_template") == "", -1, std::string("Clear the solid infill rotation template to edit solid infill direction."));
    
    toggle_line("infill_overhang_angle", config->opt_enum<InfillPattern>("sparse_infill_pattern") == InfillPattern::ipLateralHoneycomb, -1, std::string("Select the Lateral Honeycomb sparse infill pattern to use this setting."));

    toggle_line("enable_wrapping_detection", false, -1, std::string("The selected printer does not support wrapping detection."));
